# --- LLM (fashion, cocktail and book assistants) ------------------------------
# Any LangChain chat provider works. Leave LLM_MODEL empty to run without chat.
# The cocktail and book domains need no key: they are enabled once their data exists
# (uv run python -m scripts.prepare_cocktails / scripts.prepare_books; the quick start
# prepares the recipes and the books; CURIO_BOOKS=0 or DEMO_BOOKS=0 skips the books).
#
# OpenAI-compatible gateway (OmniRoute, OpenRouter, LiteLLM, Ollama, vLLM, ...):
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# Examples:
#   OpenAI:     LLM_PROVIDER=openai     LLM_MODEL=gpt-4.1-mini        (LLM_BASE_URL empty)
#   OmniRoute:  LLM_PROVIDER=openai     LLM_BASE_URL=http://localhost:20128/v1
#   Anthropic:  LLM_PROVIDER=anthropic  LLM_MODEL=claude-sonnet-5-5   (uv sync --extra anthropic;
#               the Docker image already includes it)
#   Ollama:     LLM_PROVIDER=openai     LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama
#               (docker compose --profile demo --profile ollama: LLM_BASE_URL=http://ollama:11434/v1,
#                LLM_MODEL=qwen2.5:3b or another tool-calling model)

# Signs the agent's approval proposals: at least 32 bytes, e.g. the output of
#   python -c "import secrets; print(secrets.token_hex(32))"
# Leave empty for a random per-process key. Required with several API workers.
AGENT_SIGNING_KEY=
# API worker processes (uvicorn reads it for --workers). Above 1, AGENT_SIGNING_KEY must be
# set, and each worker keeps its own record of answered proposals (see SECURITY.md).
WEB_CONCURRENCY=

# Wall-clock budget of one agent turn, in seconds (empty: 90). Raise it only for very slow
# models, such as the relayed model of the agent evaluation (docs/agent-eval.md).
AGENT_TURN_DEADLINE_SECONDS=

# Agent turns running at once across /chat and /chat/stream (empty: 8, at most 32). A turn
# over the cap gets HTTP 503 with Retry-After, so search and /health stay responsive while
# turns wait on a slow model.
MAX_CONCURRENT_TURNS=

# Largest request body in bytes (empty: 1 MiB); the photo upload allows 10 MB. Bigger
# bodies get HTTP 413 without being read in full.
MAX_BODY_BYTES=

# --- Domains ------------------------------------------------------------------
# Comma-separated domains to serve (fashion, cocktails, books). Empty: every prepared domain.
# The quick start (docker compose --profile demo up, scripts/quickstart.sh) serves cocktails
# and, once prepared, books.
ENABLED_DOMAINS=

# --- Vector store -------------------------------------------------------------
# Empty QDRANT_URL = embedded Qdrant stored in ./.qdrant (no server needed).
QDRANT_URL=
QDRANT_API_KEY=

# --- HTTP ---------------------------------------------------------------------
# Host names the API answers (the Host header, without the port); others get HTTP 400, which
# stops DNS rebinding. Empty: localhost,127.0.0.1. Add the names browsers use when you serve
# a network (CURIO_HOST=0.0.0.0). "*" turns the check off.
ALLOWED_HOSTS=
# Swagger UI at /docs (pinned, SRI-checked assets from cdn.jsdelivr.net). Empty: off.
# /openapi.json is always served.
API_DOCS=

# --- Web app ------------------------------------------------------------------
# The React app's build (npm run build in web/). The API serves it beside its own routes
# whenever the folder holds a build; set SERVE_WEB=false to turn that off.
WEB_DIST=
SERVE_WEB=
